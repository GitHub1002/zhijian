{
    "version": "0.2.0",
    "configurations": [
        
      {
        "name": "智检",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "app.main:app",
          "--host",
          "127.0.0.1",
          "--port",
          "8688"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "调试入库（隔离数据）",
        "type": "debugpy",
        "request": "launch",
        "module": "scripts.ingest",
        "cwd": "${workspaceFolder}",
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "console": "integratedTerminal",
        "justMyCode": true,
        "env": {
          "DB_PATH": "${workspaceFolder}\\data\\debug\\knowledge.db",
          "QDRANT_PATH": "${workspaceFolder}\\data\\debug\\qdrant"
        }
      }
    ]
  }