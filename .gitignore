# API Key 与敏感配置（不提交）
.env
.env.bak*

# 虚拟环境与缓存（可再生成，不提交）
.venv/
.venv-*/
venv/
__pycache__/
*.pyc

# 浏览器测试残留（非文档，约 40MB，不提交）
/docs/chrome-profile-*/

# 向量索引（可从文档重新索引，且运行时被锁定，不提交）
/data/qdrant/

# 数据库历史备份（冗余，不提交）
/data/*.bak*

# 本地账号库（含密码哈希与问答记录，不提交）
/data/knowledge.db
/data/knowledge.db-wal
/data/knowledge.db-shm

# 改名前的界面截图，含本地用户名；重截后再提交
/assets/screenshots/

# 评测报告（含检索片段正文）与评测快照，不提交
/evals/reports/
/evals/.cache/
/data/eval/

# pytest 在项目根目录生成的临时库
/.pytest_tmp/

# 本地运行数据与编辑器状态，不参与版本控制
/data/
/.cursor/
/null

# Playwright E2E：依赖、报告、失败截图和 trace 都是本地产物
/node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
